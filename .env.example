# 이 파일을 .env.local로 복사한 뒤 값을 채운다. .env.local은 Git에 올리지 않는다.

# Supabase (2단계에서 사용)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 클라이언트 코드에서 절대 사용하지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# 스케줄 수집 엔드포인트 인증 (7단계에서 사용)
CRON_SECRET=

# 로그인 (/login 화면의 아이디·비밀번호). 비밀번호는 8자 이상.
ADMIN_ID=
ADMIN_PASSWORD=
# 로그인 세션 서명용 비밀 값 (16자 이상, 화면에 입력하지 않음). `openssl rand -base64 32` 로 생성
# 이 값이나 아이디·비밀번호를 바꾸면 기존 로그인은 모두 풀린다.
ADMIN_TOKEN=
